# ---- Composio (https://dashboard.composio.dev -> Settings -> API keys) ----
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=mateo-demo
# Filled in by scripts/connect_accounts.py --trigger ...
COMPOSIO_TRIGGER_ID=
COMPOSIO_WEBHOOK_SECRET=

# ---- Parallel (https://platform.parallel.ai) ----
PARALLEL_API_KEY=
PARALLEL_PROCESSOR=base
# Public URL (cloudflared/ngrok) -> http://localhost:8000/webhooks/parallel
PARALLEL_MONITOR_WEBHOOK_URL=

# ---- Model: any OpenAI-compatible endpoint the event credits cover ----
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
MODEL=

# ---- Slack (optional; posts ONLY to your own DM) ----
SLACK_WEBHOOK_URL=
SLACK_DM_CHANNEL=

# ---- Demo ----
# Cache file in cache/<DEMO_COUNTY>.json
DEMO_COUNTY=contra_costa_walnut_creek_2026-11-03
# Who the Gmail DRAFT is addressed to (draft only, never sent automatically)
DEMO_INVITE_TO=
# cache | live
MODE=cache
