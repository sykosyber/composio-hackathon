# ---- Composio (https://dashboard.composio.dev -> Settings -> API keys) ----
# Connect Gmail, Google Sheets and Slack in the dashboard for this user id before the demo.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=mateo-demo
# Printed by scripts/connect.py --trigger <public url>/webhooks/composio
COMPOSIO_TRIGGER_ID=
COMPOSIO_WEBHOOK_SECRET=

# Shared community ledger. The id is the part of the Sheet URL between /d/ and /edit.
SHEET_ID=
SHEET_RANGE=Pins!A:Q
# Neighborhood channel. A channel id (C...) is safer than a name on Enterprise Grid.
SLACK_CHANNEL=
# Who the Gmail DRAFT is addressed to. It is a draft and the agent never sends it.
AGENCY_DRAFT_TO=

# ---- Parallel (https://platform.parallel.ai) ----
PARALLEL_API_KEY=
# turbo | fast | basic | advanced
PARALLEL_SEARCH_MODE=fast
# Public URL (cloudflared/ngrok) -> http://localhost:8000/webhooks/parallel
PARALLEL_MONITOR_WEBHOOK_URL=

# ---- Open source model behind any OpenAI compatible endpoint ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Demo ----
# 1 serves cached Parallel and LLM results first, so the stage demo is fast and repeatable.
DEMO_MODE=1
DEMO_CITY=San Francisco

# ---- Timeouts in seconds. Every external call has one. ----
SEARCH_TIMEOUT=15
LLM_TIMEOUT=30
COMPOSIO_TIMEOUT=15
