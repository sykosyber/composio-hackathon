# ---- Composio (https://dashboard.composio.dev -> Settings -> API keys) ----
# Connect Gmail, Google Sheets and Slack in the dashboard for this user id before the demo.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=mateo-demo
# Printed by scripts/connect.py --trigger <public url>/webhooks/composio
COMPOSIO_TRIGGER_ID=
COMPOSIO_WEBHOOK_SECRET=

# Shared community ledger. The id is the part of the Sheet URL between /d/ and /edit.
SHEET_ID=
SHEET_RANGE=Pins!A:Q
# Neighborhood channel. A channel id (C...) is safer than a name on Enterprise Grid.
SLACK_CHANNEL=
# Who the Gmail DRAFT is addressed to. It is a draft and the agent never sends it.
AGENCY_DRAFT_TO=

# ---- Parallel (https://platform.parallel.ai) ----
PARALLEL_API_KEY=
# turbo | fast | basic | advanced
PARALLEL_SEARCH_MODE=fast
# Public URL (cloudflared/ngrok) -> http://localhost:8000/webhooks/parallel
PARALLEL_MONITOR_WEBHOOK_URL=

# ---- Open source model behind any OpenAI compatible endpoint ----
# Easiest path: set NVIDIA_API_KEY only. That selects OpenAI's open-weight gpt-oss-20b on
# NVIDIA's free OpenAI-compatible endpoint, which routes a pin in about 5 to 10 seconds.
NVIDIA_API_KEY=
# Or point at any other OpenAI-compatible provider. These win over NVIDIA_API_KEY if set.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# gpt-oss only. "low" keeps routing inside the 30s timeout.
LLM_REASONING_EFFORT=low

# ---- TypeSafe Jev: fast typed decisions with calibrated confidence ----
# Optional. Without it the pipeline uses its keyword rules, which is the documented fallback.
# Used in three places: emergency triage, category triage, and reading agency replies.
TYPESAFE_API_KEY=
TYPESAFE_TIMEOUT=5
# A pin is an emergency if the keyword rules OR Jev say so, so Jev only ever adds caution.
JEV_EMERGENCY_THRESHOLD=0.5
JEV_CATEGORY_MIN_CONFIDENCE=0.6
JEV_REPLY_MIN_CONFIDENCE=0.7

# ---- Demo ----
# 1 serves cached Parallel and LLM results first, so the stage demo is fast and repeatable.
DEMO_MODE=1
DEMO_CITY=San Francisco

# ---- Timeouts in seconds. Every external call has one. ----
SEARCH_TIMEOUT=15
LLM_TIMEOUT=30
COMPOSIO_TIMEOUT=15
